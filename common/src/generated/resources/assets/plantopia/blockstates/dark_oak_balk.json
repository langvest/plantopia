{
    "multipart": [
        {
            "apply": {
                "model": "plantopia:block/dark_oak_balk_up"
            },
            "when": {
                "up": "true"
            }
        },
        {
            "apply": {
                "model": "plantopia:block/dark_oak_balk_down"
            },
            "when": {
                "down": "true"
            }
        },
        {
            "apply": {
                "model": "plantopia:block/dark_oak_balk_north"
            },
            "when": {
                "north": "true"
            }
        },
        {
            "apply": {
                "model": "plantopia:block/dark_oak_balk_south"
            },
            "when": {
                "south": "true"
            }
        },
        {
            "apply": {
                "model": "plantopia:block/dark_oak_balk_west"
            },
            "when": {
                "west": "true"
            }
        },
        {
            "apply": {
                "model": "plantopia:block/dark_oak_balk_east"
            },
            "when": {
                "east": "true"
            }
        },
        {
            "apply": {
